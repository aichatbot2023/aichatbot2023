# ---- obavezno u produkciji ----
# Tajna za potpisivanje klijentskih tokena. Generisi sa: openssl rand -hex 32
MCP_TOKEN_SECRET=

# Backend AiChatBot.rs platforme koji MCP server poziva (klijentski podaci)
AICHATBOT_API_URL=https://app.aichatbot.rs
# Servisni kljuc kojim se MCP server predstavlja backendu (server-to-server)
AICHATBOT_SERVICE_KEY=

# Supabase - preko edge funkcija idu alati platforme
# (demo botovi, leadovi, agenti, newsletter, read_table, invoke)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Ako se edge funkcije kod vas zovu drugacije nego u src/platform-functions.js:
# EDGE_MAP_JSON={"chat_with_bot":"bot-chat","find_leads":"lead-finder"}
EDGE_MAP_JSON=

# Javni URL MCP servera (koristi se za ispis linka klijentu)
PUBLIC_URL=https://mcp.aichatbot.rs

# ---- opciono ----
PORT=8787
LOG_LEVEL=info

# Dok backend endpointi jos ne postoje - server vraca demo podatke
DEMO_MODE=false

# Glavni prekidac za sve alate koji nesto menjaju ili salju.
# Iskljucen = ni owner token ne moze da posalje newsletter ni da obrise bota.
MCP_ALLOW_WRITE=false

# Endpoint za proveru da li je token povucen. Prazno = preskace se.
MCP_REVOCATION_URL=
MCP_REVOCATION_CACHE_MS=60000

# Zahteva po minutu po tokenu
MCP_RATE_LIMIT=120
